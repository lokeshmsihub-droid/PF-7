# Database Settings
DATABASE_URL=sqlite:////Users/lokesh/Documents/PF-7/backend/compliance.db

# Atlassian Jira OAuth 2.0 (3LO) Application Credentials
# Register your app at: https://developer.atlassian.com/console/myapps/
# Under "OAuth 2.0 (3LO)" -> Permissions -> Add "Jira platform REST API" & "Jira Service Management REST API"
# Under "Authorization" -> Add Callback URL: http://127.0.0.1:8000/api/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://127.0.0.1:8000/api/auth/jira/callback
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user read:servicedesk-request offline_access

# When JIRA_CLIENT_ID and JIRA_CLIENT_SECRET are provided, real Atlassian OAuth and live Jira Cloud REST APIs are used.
# If left blank, the system safely uses instant OAuth simulation with enterprise compliance change datasets.
JIRA_MOCK=false
