[
  {
    "check_id": "CM-001",
    "framework": "SOC2",
    "criterion": "CC8.1",
    "control_id": "CM-CONTROL-01",
    "name": "Change Authorization",
    "description": "Verifies that the change request has been formally authorized before work starts.",
    "category": "authorization",
    "severity": "high",
    "required_fields": [
      "authorization.required",
      "authorization.authorized",
      "authorization.authorized_at",
      "request.created_at",
      "deployment.deployed_at"
    ],
    "applicability": {
      "field": "authorization.required",
      "operator": "equals",
      "value": false,
      "result": "NOT_APPLICABLE"
    },
    "logic": {
      "all": [
        {
          "field": "authorization.authorized",
          "operator": "equals",
          "value": true
        },
        {
          "field": "authorization.authorized_at",
          "operator": "before_or_equal",
          "field_reference": "deployment.deployed_at"
        }
      ]
    },
    "missing_data_result": "INSUFFICIENT_DATA",
    "success_result": "PASS",
    "failure_result": "FAIL",
    "evidence_requirements": [
      {
        "evidence_type": "AUTHORIZATION_RECORD",
        "required_source": "system"
      }
    ],
    "required_data": [
      "change",
      "authorization"
    ],
    "evaluation_logic": {
      "rules": [
        {
          "subject": "authorization",
          "field": "status",
          "operator": "EQUALS",
          "value": "APPROVED"
        }
      ],
      "relationships": [
        {
          "subject": "authorization",
          "related_subject": "change",
          "operator": "BEFORE",
          "source_field": "authorized_at",
          "target_field": "implemented_at"
        }
      ]
    }
  },
